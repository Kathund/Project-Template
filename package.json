{
  "name": "Project-Template",
  "module": "index.ts",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.1.2",
    "npm": "forbidden, use pnpm instead",
    "yarn": "forbidden, use pnpm instead",
    "bun": "forbidden, use pnpm instead"
  },
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "start": "pnpm exec tsx index.ts",
    "prettier": "pnpm exec prettier --write .",
    "prettier:check": "pnpm exec prettier --check .",
    "eslint:check": "pnpm exec eslint . ",
    "eslint": "pnpm eslint:check --fix",
    "build": "pnpm exec tsc --build",
    "check": "pnpm prettier && pnpm eslint && pnpm run build"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "node-cache": "^5.1.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@j4cobi/eslint-plugin-sort-imports": "^1.0.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/eslint": "^9.6.1",
    "@types/node": "^26.2.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
